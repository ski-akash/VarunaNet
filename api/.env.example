PORT=3000
HOST=0.0.0.0
INFERENCE_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://localhost:5432/varunanet
RESULT_CACHE_TTL_SECONDS=3600
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:5173
# Comma-separated list of accepted x-api-key values. Empty (the default)
# means auth is off -- fine for local dev, not for anything else.
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Enables POST /chat when set. Empty (the default) means the chat route
# isn't registered at all -- 404, not a broken 500.
GEMINI_API_KEY=

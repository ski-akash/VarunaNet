# React + Vite dashboard, built to static files and served by nginx.
#
# NOTE: not yet built or run -- same Docker-unavailable caveat as
# Dockerfile.api and Dockerfile.serve. Reviewed but unverified.

FROM node:22-slim AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# VITE_API_BASE_URL is baked into the static build at build time (Vite env
# vars are compile-time, not runtime) -- docker-compose.yml passes it as a
# build arg so the gateway's in-compose service name is what ships, not the
# frontend/.env.example default meant for a bare `npm run dev`.
ARG VITE_API_BASE_URL=http://localhost:3000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ---- runtime: plain nginx serving the static build, nothing else
FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html

# A single-page app needs every unknown path to fall back to index.html
# (client-side routing), not nginx's default 404 -- there's no routing yet,
# but this is the same reasoning MapView's own history-independent design
# will eventually need, and it costs nothing to have right from the start.
COPY infra/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
